// 127.0.0.1 rather than localhost: on Windows 11 localhost resolves ::1 first while uvicorn
// binds IPv4, producing intermittent ECONNREFUSED that reads as a dead server.
{
  "/api/inventory": {
    "target": "http://127.0.0.1:8100",
    "changeOrigin": true,
    "pathRewrite": { "^/api/inventory": "/api" }
  },
  // Key must match `deploymentApi.baseUrl` in environment.development.ts exactly — a
  // near-miss here does not error, it just leaves the request unproxied and 404ing off
  // the dev server. No pathRewrite yet: unlike the inventory service, the deploy service
  // is still faked, so its route prefix has not been pinned down. Expect to need
  // `"pathRewrite": { "^/api/deployments": "/api" }` if it mounts its router the same way.
  "/api/deployments": {
    "target": "http://127.0.0.1:9000",
    "changeOrigin": true
  }
}
